APP_NAME=CognitoSense Backend
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (centralized Postgres)
POSTGRES_USER=to be filled
POSTGRES_PASSWORD=to be filled
POSTGRES_HOST=to be filled
POSTGRES_PORT=to be filled
POSTGRES_DB=to be filled
# Set to "true" only if the Postgres server requires SSL
PGSSL=false

# Auth
JWT_SECRET=to be filled with a long random string
JWT_EXPIRES_IN=7d

GROQ_API_KEY=fill in your GROQ API key here

NIXPACKS_NODE_VERSION=22
